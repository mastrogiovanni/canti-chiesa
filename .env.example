# Il server rimane accessibile solo dal Raspberry Pi. Collegarsi via SSH tunnel.
CANTI_HOST=127.0.0.1
CANTI_PORT=8787

# Hook opzionali per gestire uscita/standby video; lasciare vuoti per non usarli.
# Comando eseguito come utente del servizio quando inizia/termina una canzone.
DISPLAY_ON_COMMAND=
DISPLAY_OFF_COMMAND=
